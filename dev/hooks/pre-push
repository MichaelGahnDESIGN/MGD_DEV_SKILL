#!/usr/bin/env bash
# Prüft vor einem Push alle erreichbaren neuen Commits einschließlich Zwischenständen.
# Bestehende Hook-Verwaltung beim Installieren erhalten; diesen Hook dort einbinden.
# Python 3 ist erforderlich. Bei fehlendem Werkzeug oder unlesbarer Historie wird blockiert.
set -euo pipefail
python3 - 3<&0 <<'PY'
import os
import re
import subprocess
import sys

def sperren(grund):
    # Keine sensiblen Dateinamen oder Inhalte in gemeinsam genutzte Logs schreiben.
    print('Push blockiert: ' + grund, file=sys.stderr)
    raise SystemExit(1)

def git(*argumente):
    ergebnis = subprocess.run(['git', *argumente], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if ergebnis.returncode:
        sperren('Git-Historie konnte nicht vollständig geprüft werden.')
    return ergebnis.stdout

def nullwert(wert):
    return bool(wert) and set(wert) == {'0'}

def sensibel(pfad):
    # SQL-Quellcode für Schema/Migrationen ist zulässig; Dumps/Backups bleiben lokal.
    teile = pfad.lower().split(b'/')
    datei = teile[-1]
    if datei == b'.env.example':
        return False
    if datei == b'.env' or datei.startswith(b'.env.'):
        return True
    if any(t.startswith(b'backup') or t in (b'playtest', b'play-test', b'play_test') for t in teile):
        return True
    return (datei.endswith((b'.pem', b'.key', b'.dump', b'.sql.gz'))
            or datei.startswith((b'id_rsa', b'id_ed25519', b'server_access', b'credentials'))
            or (datei.endswith(b'.sql') and any(t in datei for t in (b'dump', b'backup'))))

geprueft = set()
for zeile in os.fdopen(3):
    felder = zeile.split()
    if len(felder) != 4:
        sperren('Ungültige Referenzinformationen.')
    lokale_ref, lokal, remote_ref, remote = felder
    if nullwert(lokal):
        continue  # Git-Ref-Löschungen enthalten keine neu übertragenen Objekte.
    if re.search(r'play[-_]?test', lokale_ref + ' ' + remote_ref, re.I):
        sperren('Playtest-Referenzen müssen lokal bleiben.')
    # Auch annotierte Tags werden auf einen Commit aufgelöst; unbekannte Objekte blockieren.
    kopf = git('rev-parse', '--verify', lokal + '^{commit}').decode().strip()
    args = ['rev-list', kopf]
    if not nullwert(remote):
        basis = git('rev-parse', '--verify', remote + '^{commit}').decode().strip()
        args += ['--not', basis]
    for commit in git(*args).decode().splitlines():
        if commit in geprueft:
            continue
        geprueft.add(commit)
        # Vollständiger Baum jedes neuen Commits: Root-, Merge- und gelöschte Zwischenstände.
        for pfad in git('ls-tree', '-r', '--name-only', '-z', commit).split(b'\0'):
            if pfad and sensibel(pfad):
                sperren('Ein neuer Commit enthält eine geschützte Datei oder einen Backup-/Playtest-Pfad.')
PY
